# SignalFlow local development environment
# Copy to .env.local or export these values in the shell that starts the control plane.
# Never commit .env.local and never use VITE_ for secrets.

META_APP_ID=
VITE_META_APP_ID=
META_APP_SECRET=
META_DEV_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_REDIRECT_URI=https://localhost/oauth/callback
META_LIVE_PUBLISHING=false
SIGNALFLOW_TOKEN_VAULT=dotenv
# Optional absolute path shared by Electron, Tauri and the local Control Plane.
# Defaults to ~/.signalflow/.env and is created with user-only permissions.
SIGNALFLOW_ENV_FILE=
# Set only for isolated tests/dev; never use for real-account operation.
SIGNALFLOW_ALLOW_MEMORY_TOKEN_VAULT=false
PORT=18787
# Optional local durable worker used for approved Meta Page jobs while SignalFlow is closed.
# VITE_WORKER_URL=http://127.0.0.1:18788
SIGNALFLOW_WORKER_PORT=18788
SIGNALFLOW_WORKER_DB=signalflow-worker.sqlite3
SIGNALFLOW_PROVIDER_EXECUTOR_URL=http://127.0.0.1:18787/v1/worker/meta/page-text
# Set the same random value in both processes when enabling worker auth.
SIGNALFLOW_WORKER_AUTH_TOKEN=
